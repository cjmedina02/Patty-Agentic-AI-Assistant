# ============================================================
# Campsite Checker — Environment Variables
# Copy this to .env and fill in your values.
# ============================================================

# --- OpenAI (already set in your Korra .env) ---
OPENAI_API_KEY=sk-...

# --- Discord Webhook ---
# 1. Open Discord → Server Settings → Integrations → Webhooks → New Webhook
# 2. Choose a channel (e.g. #campsite-alerts)
# 3. Copy the webhook URL and paste below
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# --- Location ---
HOME_ZIP=92126
MAX_DISTANCE_MILES=300

# --- Recreation.gov ---
# Free API key: https://ridb.recreation.gov/profile
RECREATION_GOV_API_KEY=your_key_here

# --- Date range to monitor ---
# Leave blank to use the next 90 days automatically
CHECK_DATE_START=2025-06-01
CHECK_DATE_END=2025-08-31

# --- Azure Table Storage (for persistent state) ---
# Get this from Azure Portal → Storage Account → Access Keys → Connection string
# If left blank, a local campsite_state.json file is used instead
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# --- Local fallback state file (used if Azure Storage is not configured) ---
CAMPSITE_STATE_FILE=campsite_state.json
